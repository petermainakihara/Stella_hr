<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_checkin_session_tree" model="ir.ui.view">
        <field name="name">project.checkin.session.tree</field>
        <field name="model">mobipine_project.checkin_session</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="check_in_time"/>
                <field name="check_out_time"/>
                <field name="duration_hours"/>
            </list>
        </field>
    </record>

    <record id="view_project_checkin_session_form" model="ir.ui.view">
        <field name="name">project.checkin.session.form</field>
        <field name="model">mobipine_project.checkin_session</field>
        <field name="arch" type="xml">
            <form string="Check-in Session">
                <sheet>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="user_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="check_in_time"/>
                            <field name="check_out_time"/>
                            <field name="duration_hours" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="geo_lat"/>
                        <field name="geo_lng"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_project_checkin_session" model="ir.actions.act_window">
        <field name="name">Check-in Sessions</field>
        <field name="res_model">mobipine_project.checkin_session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
