              sequence="10"
              groups="mobipine_odoo_project_management.group_project_manager,base.group_system"/>

    <menuitem id="menu_stellar_hr_hr_function"
              name="HR Functions"
              parent="menu_stellar_hr_utilities"
              action="action_mobipine_project_hr_function"
              sequence="20"
              groups="mobipine_odoo_project_management.group_project_manager,base.group_system"/>

    <menuitem id="menu_stellar_hr_task_template"
              name="Task Templates"
