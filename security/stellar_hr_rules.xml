<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_mobipine_project_sla_company" model="ir.rule">
            <field name="name">SLA company scope</field>
            <field name="model_id" ref="model_mobipine_project_sla"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('mobipine_odoo_project_management.group_project_manager'))]"/>
        </record>

        <record id="rule_mobipine_project_checkin_session_own" model="ir.rule">
            <field name="name">Associate check-in sessions: own only</field>
            <field name="model_id" ref="model_mobipine_project_checkin_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('mobipine_odoo_project_management.group_hr_associate'))]"/>
        </record>
    </data>
</odoo>
