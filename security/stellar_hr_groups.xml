<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_stellar_hr" model="ir.module.category">
            <field name="name">StellarHR</field>
            <field name="sequence">65</field>
        </record>

        <record id="privilege_stellar_hr" model="res.groups.privilege">
            <field name="name">StellarHR</field>
            <field name="category_id" ref="mobipine_odoo_project_management.module_category_stellar_hr"/>
            <field name="sequence">65</field>
        </record>

        <record id="group_project_manager" model="res.groups">
            <field name="name">StellarHR Project Manager</field>
            <field name="privilege_id" ref="mobipine_odoo_project_management.privilege_stellar_hr"/>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        </record>

        <record id="group_hr_associate" model="res.groups">
            <field name="name">StellarHR HR Associate</field>
            <field name="privilege_id" ref="mobipine_odoo_project_management.privilege_stellar_hr"/>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        </record>
    </data>
</odoo>
