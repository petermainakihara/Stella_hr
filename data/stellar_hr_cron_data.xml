<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_mobipine_spawn_project_tasks" model="ir.cron">
            <field name="name">StellarHR: Spawn Recurring Tasks</field>
            <field name="model_id" ref="model_mobipine_project_task_template"/>
            <field name="state">code</field>
            <field name="code">model.cron_spawn_tasks_from_templates()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
